# FlightHub local development env.
# Shared local defaults for the team. Do not put real secrets here.

EUREKA_CLIENT_SERVICEURL_DEFAULTZONE=http://localhost:8761/eureka/
JPA_DDL_AUTO=update
JPA_SHOW_SQL=true
JPA_FORMAT_SQL=true
HIBERNATE_SQL_LOG_LEVEL=DEBUG
HIBERNATE_BIND_LOG_LEVEL=TRACE
SPRING_KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Optional per-service Kafka overrides.
# USER_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# BOOKING_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# PAYMENT_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# FLIGHT_OPS_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# SEAT_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# NOTIFICATION_KAFKA_BOOTSTRAP_SERVERS=localhost:9092

SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379

# Local PostgreSQL credentials.
FLIGHTHUB_DATASOURCE_USERNAME=postgres
FLIGHTHUB_DATASOURCE_PASSWORD=12345678

USER_DATASOURCE_URL=jdbc:postgresql://localhost:15432/airline_user
AIRLINE_CORE_DATASOURCE_URL=jdbc:postgresql://localhost:5433/airline_core_db
FLIGHT_OPS_DATASOURCE_URL=jdbc:postgresql://localhost:5434/airline_flight_db
LOCATION_DATASOURCE_URL=jdbc:postgresql://localhost:5435/airline_location_db
SEAT_DATASOURCE_URL=jdbc:postgresql://localhost:5436/airline_seat_db
PRICING_DATASOURCE_URL=jdbc:postgresql://localhost:5437/airline_pricing_db
ANCILLARY_DATASOURCE_URL=jdbc:postgresql://localhost:5438/airline_ancillary_db
BOOKING_DATASOURCE_URL=jdbc:postgresql://localhost:5439/airline_booking_db
PAYMENT_DATASOURCE_URL=jdbc:postgresql://localhost:5440/airline_payment_db
SUBSCRIPTION_DATASOURCE_URL=jdbc:postgresql://localhost:5441/airline_subscription_db
NOTIFICATION_DATASOURCE_URL=jdbc:postgresql://localhost:5442/airline_notification_db

# Local external providers. Fill these only when testing the integrations.
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id
PAYMENT_RECONCILIATION_ENABLED=true
MAIL_USERNAME=your_mail_username
MAIL_APP_PASSWORD=your_mail_app_password
MAIL_FROM=flight.hub015@gmail.com
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=your_twilio_from_number
TWILIO_ENABLED=false
FRONTEND_BASE_URL=http://localhost:5173
