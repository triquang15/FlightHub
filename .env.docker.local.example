# Copy to .env.docker.local for a local Docker production dry-run.
# This file intentionally uses local/demo defaults. Keep real prod secrets out of Git.

FLIGHTHUB_IMAGE_TAG=latest
FLIGHTHUB_PLATFORM_IMAGE_TAG=latest
FLIGHTHUB_IMAGE_PLATFORM=linux/amd64
FRONTEND_HOST_PORT=5173
EUREKA_HOST_PORT=8761
CONFIG_SERVER_HOST_PORT=8888

# Docker prod database mode:
# - local-db: start local Postgres containers
# - none: do not start local Postgres containers; use managed Postgres/Neon URLs below
FLIGHTHUB_PROD_PROFILES=local-db

# Full Docker stack resource defaults. Increase these if all services boot slowly.
FLIGHTHUB_JAVA_TOOL_OPTIONS=-Xms192m -Xmx640m -XX:+UseG1GC -XX:MaxRAMPercentage=75
FLIGHTHUB_CONFIG_JAVA_TOOL_OPTIONS=-Xms192m -Xmx640m -XX:+UseG1GC -XX:MaxRAMPercentage=75
FLIGHTHUB_PLATFORM_JAVA_TOOL_OPTIONS=-Xms192m -Xmx640m -XX:+UseG1GC -XX:MaxRAMPercentage=75
FLIGHTHUB_APP_MEM_LIMIT=1g
FLIGHTHUB_APP_MEM_RESERVATION=512m
FLIGHTHUB_APP_CPUS=1.0
FLIGHTHUB_DATASOURCE_POOL_MAXIMUM_SIZE=5
FLIGHTHUB_DATASOURCE_POOL_MINIMUM_IDLE=1
FLIGHTHUB_DATASOURCE_POOL_CONNECTION_TIMEOUT_MS=30000

POSTGRES_PASSWORD=12345678
FLIGHTHUB_DATASOURCE_USERNAME=postgres
FLIGHTHUB_DATASOURCE_PASSWORD=12345678

# Local Docker dry-run should create/update schemas automatically.
# Use validate + Flyway only after the production migrations are complete.
JPA_DDL_AUTO=update
FLYWAY_ENABLED=false
FLYWAY_BASELINE_ON_MIGRATE=true
JPA_SHOW_SQL=false
JPA_FORMAT_SQL=false
HIBERNATE_SQL_LOG_LEVEL=warn
HIBERNATE_BIND_LOG_LEVEL=warn

REDIS_HOST_PORT=6379
KAFKA_HOST_PORT=9092
KAFKA_UI_HOST_PORT=8000
SPRING_DATA_REDIS_HOST=redis
SPRING_DATA_REDIS_PORT=6379
SPRING_KAFKA_BOOTSTRAP_SERVERS=kafka:9092

USERDB_HOST_PORT=15432
AIRLINECOREDB_HOST_PORT=5433
FLIGHTOPSDB_HOST_PORT=5434
LOCATIONDB_HOST_PORT=5435

# Neon/managed Postgres mode.
# Set FLIGHTHUB_PROD_PROFILES=none and fill these JDBC URLs with sslmode=require.
# Prefer Neon pooled connection strings for Docker demo/prod-like runs.
# Example:
# USER_DATABASE_URL=jdbc:postgresql://ep-demo-pooler.ap-southeast-1.aws.neon.tech/airline_user?sslmode=require
USER_DATABASE_URL=
AIRLINE_CORE_DATABASE_URL=
FLIGHT_OPS_DATABASE_URL=
LOCATION_DATABASE_URL=
SEAT_DATABASE_URL=
PRICING_DATABASE_URL=
ANCILLARY_DATABASE_URL=
BOOKING_DATABASE_URL=
PAYMENT_DATABASE_URL=
MEDIA_DATABASE_URL=
NOTIFICATION_DATABASE_URL=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=
PAYMENT_RECONCILIATION_ENABLED=true

GOOGLE_CLIENT_ID=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

MAIL_USERNAME=
MAIL_APP_PASSWORD=
MAIL_FROM=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_ENABLED=false

FRONTEND_BASE_URL=http://localhost:5173
EUREKA_CLIENT_SERVICEURL_DEFAULTZONE=http://service-registry:8761/eureka/
GATEWAY_RATE_LIMIT_CAPACITY=60
GATEWAY_RATE_LIMIT_WINDOW_SECONDS=60
GATEWAY_AUTH_RATE_LIMIT_CAPACITY=20
GATEWAY_AUTH_RATE_LIMIT_WINDOW_SECONDS=60
GATEWAY_RATE_LIMIT_FAIL_OPEN=true
GATEWAY_TOKEN_BLACKLIST_FAIL_OPEN=true

MEDIA_STORAGE_PROVIDER=LOCAL
MEDIA_STORAGE_PATH=/data/media
MEDIA_PUBLIC_BASE_URL=http://localhost:8080
MEDIA_SERVICE_BASE_URL=http://media-service:8089
MEDIA_MAX_FILE_SIZE_BYTES=8388608

# Frontend image build args used by microservices/scripts/build-local-images.sh.
VITE_API_BASE_URL=http://localhost:8080
VITE_GOOGLE_CLIENT_ID=
VITE_FACEBOOK_APP_ID=
