# Copy to .env.docker.local for a local Docker production dry-run.
# This file intentionally uses local/demo defaults. Keep real prod secrets out of Git.

FLIGHTHUB_IMAGE_TAG=local
FLIGHTHUB_PLATFORM_IMAGE_TAG=local
FRONTEND_HOST_PORT=5173

POSTGRES_PASSWORD=12345678
FLIGHTHUB_DATASOURCE_USERNAME=postgres
FLIGHTHUB_DATASOURCE_PASSWORD=12345678

# Local Docker dry-run should create/update schemas automatically.
# Use validate + Flyway only after the production migrations are complete.
JPA_DDL_AUTO=update
FLYWAY_ENABLED=false
FLYWAY_BASELINE_ON_MIGRATE=true

REDIS_HOST_PORT=6379
KAFKA_HOST_PORT=9092
KAFKA_UI_HOST_PORT=8000

USERDB_HOST_PORT=15432
AIRLINECOREDB_HOST_PORT=5433
FLIGHTOPSDB_HOST_PORT=5434
LOCATIONDB_HOST_PORT=5435

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=
PAYMENT_RECONCILIATION_ENABLED=true

GOOGLE_CLIENT_ID=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

MAIL_USERNAME=
MAIL_APP_PASSWORD=
MAIL_FROM=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_ENABLED=false

FRONTEND_BASE_URL=http://localhost:5173
MEDIA_STORAGE_PROVIDER=LOCAL
MEDIA_PUBLIC_BASE_URL=http://localhost:8080
MEDIA_MAX_FILE_SIZE_BYTES=8388608

# Frontend image build args used by microservices/scripts/build-local-images.sh.
VITE_API_BASE_URL=http://localhost:8080
VITE_GOOGLE_CLIENT_ID=
VITE_FACEBOOK_APP_ID=
