# Copy this template to your deployment secret store or a local .env.prod file.
# For local development, use .env.local.
# Do not commit real values.

EUREKA_CLIENT_SERVICEURL_DEFAULTZONE=http://service-registry:8761/eureka/
# Enable only after each service database has a full baseline schema or an
# existing schema that can be safely baselined by Flyway.
FLYWAY_ENABLED=true
FLYWAY_BASELINE_ON_MIGRATE=true
JPA_DDL_AUTO=validate
JPA_SHOW_SQL=false
JPA_FORMAT_SQL=false
HIBERNATE_SQL_LOG_LEVEL=WARN
HIBERNATE_BIND_LOG_LEVEL=WARN
FLIGHTHUB_IMAGE_TAG=<release-tag>
FLIGHTHUB_PLATFORM_IMAGE_TAG=<release-tag>
SPRING_KAFKA_BOOTSTRAP_SERVERS=kafka:9092
SPRING_DATA_REDIS_HOST=redis
SPRING_DATA_REDIS_PORT=6379

# Optional per-service Kafka overrides.
# USER_KAFKA_BOOTSTRAP_SERVERS=kafka:9092
# BOOKING_KAFKA_BOOTSTRAP_SERVERS=kafka:9092
# PAYMENT_KAFKA_BOOTSTRAP_SERVERS=kafka:9092
# FLIGHT_OPS_KAFKA_BOOTSTRAP_SERVERS=kafka:9092
# SEAT_KAFKA_BOOTSTRAP_SERVERS=kafka:9092
# NOTIFICATION_KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# Shared DB credentials. Override per service with <SERVICE>_DATASOURCE_USERNAME
# and <SERVICE>_DATASOURCE_PASSWORD only when a service uses a different DB user.
FLIGHTHUB_DATASOURCE_USERNAME=<postgres-user>
FLIGHTHUB_DATASOURCE_PASSWORD=<postgres-password>

USER_DATASOURCE_URL=jdbc:postgresql://<host>/airline_user_db?sslmode=require
AIRLINE_CORE_DATASOURCE_URL=jdbc:postgresql://<host>/airline_core_db?sslmode=require
FLIGHT_OPS_DATASOURCE_URL=jdbc:postgresql://<host>/airline_flight_db?sslmode=require
LOCATION_DATASOURCE_URL=jdbc:postgresql://<host>/airline_location_db?sslmode=require
SEAT_DATASOURCE_URL=jdbc:postgresql://<host>/airline_seat_db?sslmode=require
PRICING_DATASOURCE_URL=jdbc:postgresql://<host>/airline_pricing_db?sslmode=require
ANCILLARY_DATASOURCE_URL=jdbc:postgresql://<host>/airline_ancillary_db?sslmode=require
BOOKING_DATASOURCE_URL=jdbc:postgresql://<host>/airline_booking_db?sslmode=require
PAYMENT_DATASOURCE_URL=jdbc:postgresql://<host>/airline_payment_db?sslmode=require
SUBSCRIPTION_DATASOURCE_URL=jdbc:postgresql://<host>/airline_subscription_db?sslmode=require
NOTIFICATION_DATASOURCE_URL=jdbc:postgresql://<host>/airline_notification_db?sslmode=require

STRIPE_SECRET_KEY=<stripe-secret-key>
PAYPAL_CLIENT_ID=<paypal-client-id>
PAYPAL_CLIENT_SECRET=<paypal-client-secret>
PAYPAL_BASE_URL=https://api-m.paypal.com

MAIL_USERNAME=<smtp-username>
MAIL_APP_PASSWORD=<smtp-password>
MAIL_FROM=<notification-from-email>

TWILIO_ACCOUNT_SID=<twilio-account-sid>
TWILIO_AUTH_TOKEN=<twilio-auth-token>
TWILIO_FROM_NUMBER=<twilio-from-number>
TWILIO_ENABLED=false

FRONTEND_BASE_URL=https://<frontend-domain>
